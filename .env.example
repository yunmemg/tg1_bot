# Copy to Railway Variables (or a local .env). Do not commit real secrets.

# --- Required ---
API_ID=12345678
API_HASH=your_api_hash_from_my_telegram_org
BOT_TOKEN=123456:ABC-DEF_from_BotFather
ADMIN_IDS=123456789

# Payment (required by current startup check; use real OkayPay values in production)
MERCHANT_ID=your_merchant_id
PAYMENT_TOKEN=your_payment_token
PAYMENT_RETURN_URL=https://t.me/YourBotUsername

# --- Railway volume (recommended) ---
# Mount a Railway Volume at /data, then set:
ANTI_LOGIN_DATA_ROOT=/data

# --- Optional tuning ---
# SESSION_LOAD_CONCURRENCY=3
# RESET_AUTHORIZATION_CONCURRENCY=5
# PROTECTION_BOOST_SECONDS=300
# BOT_LOG_DIR=logs
