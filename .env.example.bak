# Telegram Bot Token，从 @BotFather 获取
BOT_TOKEN=123456789:your-telegram-bot-token

# 可选：允许使用机器人的用户 ID 白名单，逗号分隔。留空表示所有人可用
# ALLOWED_USER_IDS=111111111,222222222

# 可选：管理员用户 ID 列表，逗号分隔。只有管理员可以执行 /login 扫码登录，
# 登录凭证全局共享，所有用户点歌时都会使用该登录态解析完整音频。
# 留空表示所有人可执行登录。
# ADMIN_IDS=111111111

# 可选：残像API（apicx.asia）的 token，用于汽水音乐付费歌曲回退解析。
# 需要到 https://apicx.asia 注册后获取。留空则不使用。
# QISHUI_TOKEN=
